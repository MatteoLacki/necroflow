#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

changed_python_files=()
while IFS= read -r -d '' path; do
    changed_python_files+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMRD --no-renames -z -- '*.py')
if [ "${#changed_python_files[@]}" -eq 0 ]; then
    echo "[pre-commit] no staged Python changes — skipping Black and pytest."
    exit 0
fi

if [ ! -f .venv/bin/black ] || [ ! -f .venv/bin/pytest ]; then
    echo "[pre-commit] .venv is missing black or pytest — run 'make venv' first" >&2
    exit 1
fi

python_files=()
while IFS= read -r -d '' path; do
    python_files+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR --no-renames -z -- '*.py')
if [ "${#python_files[@]}" -gt 0 ]; then
    echo "[pre-commit] formatting staged Python files with black..."
    .venv/bin/black "${python_files[@]}"
    git add -- "${python_files[@]}"
fi

echo "[pre-commit] running pytest..."
.venv/bin/pytest -q
